@@ -26,9 +26,10 @@ type RealPlan struct {
 
 	// scratch pools a single 2·m complex128 buffer per concurrent caller so the
 	// pack/untangle (and the inverse's reverse-untangle/unpack) reuse a private
-	// working set instead of allocating two m-length buffers every call. The plan
-	// stays immutable and concurrent-safe: each Get hands out a buffer owned by
-	// that call for its duration. nil for the odd path.
+	// working set instead of allocating two m-length buffers every call; past
+	// those 2·m entries it holds the Stockham half plan's scratch (comp2Half).
+	// The plan stays immutable and concurrent-safe: each Get hands out a
+	// buffer owned by that call for its duration. nil for the odd path.
 	scratch *sync.Pool
 
 	// Odd path: full complex plan of length n.
@@ -53,13 +54,31 @@ func NewRealPlan(n int) *RealPlan {
 		ang := -2 * math.Pi * float64(k) / float64(n)
 		p.tw[k] = complex(math.Cos(ang), math.Sin(ang))
 	}
+	size := 2 * m
+	if p.half.sk != nil {
+		// Room for the half plan's own scratch (comp2Half).
+		size += p.half.sk.scratchLen
+	}
 	p.scratch = &sync.Pool{New: func() any {
-		s := make([]complex128, 2*m)
+		s := make([]complex128, size)
