 }
 
+// comp2Half runs the half-length transform from src into dst, which must not
+// overlap. A Stockham half plan runs on the tail of buf, the buffer the
+// caller borrowed from p.scratch, rather than on one borrowed from its own
+// pool: a sync.Pool Get and Put cost 16 ns on Zen 3 (Round 26), 5% of a
+// 256-point RFFT.
+func (p *RealPlan) comp2Half(dst, src []complex128, buf *[]complex128, inverse bool) {
+	if sk := p.half.sk; sk != nil {
+		sk.run(dst, src, (*buf)[p.n:], inverse)
+		return
+	}
+	p.half.execute(dst, src, inverse)
+}
+
 // getScratch borrows the plan's pooled 2·m working buffer, split into two
 // m-length halves (z for packing, Z for the spectrum). putScratch returns it.
 func (p *RealPlan) getScratch() (buf *[]complex128, z, Z []complex128) {
@@ -114,7 +133,7 @@ func (p *RealPlan) RFFT(dst []complex128, src []float64) []complex128 {
 		// The packing z[j] = src[2j] + i·src[2j+1] is exactly the memory layout
 		// of a []complex128, so the half-length FFT reads src through a view of
 		// it: no pack pass. The plan only reads its source.
-		p.half.execute(Z, asComplex(src[:2*m]), false)
+		p.comp2Half(Z, asComplex(src[:2*m]), buf, false)
 	}
 	rfftUntangle(dst, Z, p.tw, m)
 	p.putScratch(buf)
@@ -299,7 +318,7 @@ func (p *RealPlan) irfftPacked(dst []float64, src []complex128) []float64 {
 	// z[j] = x[2j] + i·x[2j+1] is the memory layout of dst read as complex128,
 	// so the (already scaled) inverse writes the real signal in place: no
 	// unpack pass.
-	p.half.execute(asComplex(dst[:2*m]), Z, true)
+	p.comp2Half(asComplex(dst[:2*m]), Z, buf, true)
 	p.putScratch(buf)
 	return dst
 }
